# Vercel Blob storage
BLOB_READ_WRITE_TOKEN=

# EmailJS (public)
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_USER_ID=

# better-auth
